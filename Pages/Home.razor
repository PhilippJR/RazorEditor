@page "/"
@using RazorEditor.Shared

<PageTitle>Home</PageTitle>

@* VS 18.5: CTRL+K,D moves "bar" and "baz" further and further to the right. Just repeat CTRL+K,D... *@
@* VS 18.6: CTRL+K,D moves "bar" and "baz" further and further to the right. Just repeat CTRL+K,D... *@
@* VS 18.7: CTRL+K,D moves "bar" and "baz" further and further to the right. Just repeat CTRL+K,D... *@
@* VS 18.8: fixed *@
<MyComponent Show="@_bool1"
             String="@("foo " +
                       "bar " +
                       "baz")" />

@* VS 18.8: CTRL+K,D moves "bar" and "baz" further and further to the right. Just repeat CTRL+K,D... *@
<div>
    <MyComponent Show="@_bool1"
                 String="@("foo " +
                           "bar " +
                           "baz")" />
</div>

@* VS 18.8: CTRL+K,D removes the indentation of "<MyComponent2 Strings="@(["string1"," *@
<div>
    <MyComponent2 Strings="@(["string1",
                              "string2",
                              "string3"])" />
</div>

@* VS 18.8: It works well when there are no line breaks *@
<div>
    <MyComponent2 Strings="@(["string1", "string2", "string3"])" />
</div>